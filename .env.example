# Server-side only — read by the /api/gemini serverless function and never bundled into the browser.
# Locally, `npm run dev` loads it from .env. On Vercel, add it under Project Settings → Environment Variables.
# Do NOT prefix it with VITE_: that would ship the key to every visitor of the site.
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (the anon key is public by design)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
